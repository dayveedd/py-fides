{
  "name": "py-fides",
  "version": "1.0.0",
  "description": "AP2-Compliant Omnichannel Escrow Agent for Machine-to-Machine (A2A) Commerce on PayPal Rails",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc && rm -rf dist/ui && cp -r src/ui dist/ui",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "paypal",
    "ap2",
    "agentic-commerce",
    "escrow",
    "a2a",
    "pyusd",
    "apimatic",
    "ag-grid",
    "cryptographic-mandates"
  ],
  "author": "pyFides Team",
  "license": "Apache-2.0",
  "dependencies": {
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
